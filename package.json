{
  "name": "obsidian-terminal",
  "version": "0.2.0",
  "description": "Embedded terminal for Obsidian — run CLI tools, use AI agents right inside your vault",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "terminal",
    "xterm"
  ],
  "author": "Pavel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20",
    "builtin-modules": "^4",
    "esbuild": "^0.24",
    "obsidian": "^1.7",
    "typescript": "^5.5"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10",
    "@xterm/addon-webgl": "^0.18",
    "@xterm/xterm": "^5.5"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "^1.2.0-beta.14",
    "@lydell/node-pty-darwin-x64": "^1.2.0-beta.14",
    "@lydell/node-pty-win32-x64": "^1.2.0-beta.14",
    "@lydell/node-pty-win32-arm64": "^1.2.0-beta.14"
  }
}
